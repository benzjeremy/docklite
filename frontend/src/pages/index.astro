---
// Docklite - Ultra-lightweight Docker Resource Monitor & Dashboard
// Designed for high performance and zero memory bloat.
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Docklite · Lightweight Docker Monitor</title>
  <meta name="description" content="Ultra-lightweight Portainer alternative in Go and Astro. Real-time Docker resource monitoring directly from docker.sock." />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2300f2fe' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='7' width='20' height='14' rx='2' ry='2'></rect><path d='M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16'></path></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #07090e;
      --card-bg: rgba(15, 21, 32, 0.85);
      --card-border: #1e293b;
      --card-hover: rgba(26, 36, 56, 0.95);
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --accent: #00f2fe;
      --accent-glow: rgba(0, 242, 254, 0.25);
      --accent-secondary: #4facfe;
      --success: #10b981;
      --success-glow: rgba(16, 185, 129, 0.25);
      --warning: #f59e0b;
      --danger: #ef4444;
      --info: #38bdf8;
      --terminal-bg: #05070a;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'Fira Code', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg);
      background-image: 
        radial-gradient(at 0% 0%, rgba(0, 242, 254, 0.04) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(79, 172, 254, 0.04) 0px, transparent 50%);
      color: var(--text);
      font-family: var(--font-sans);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    header {
      background: rgba(11, 15, 25, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--card-border);
      position: sticky;
      top: 0;
      z-index: 50;
      padding: 0.85rem 1.75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: inherit;
    }

    .brand-logo {
      width: 38px;
      height: 38px;
      background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #05070a;
      font-weight: 800;
      font-size: 1.25rem;
      box-shadow: 0 0 16px var(--accent-glow);
    }

    .brand-text h1 {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .brand-text span {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 400;
    }

    .badge-live {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.2rem 0.55rem;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 9999px;
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--success);
    }

    .badge-live .pulse-dot {
      width: 6px;
      height: 6px;
      background: var(--success);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--success);
      animation: pulse 2s infinite ease-in-out;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .btn {
      background: #162032;
      color: var(--text);
      border: 1px solid var(--card-border);
      padding: 0.45rem 0.85rem;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn:hover {
      background: #1f2d47;
      border-color: #334155;
      color: #fff;
    }

    .btn-primary {
      background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
      color: #07090e;
      border: none;
      font-weight: 600;
    }

    .btn-primary:hover {
      box-shadow: 0 0 16px var(--accent-glow);
      filter: brightness(1.08);
      color: #000;
    }

    .btn-sm {
      padding: 0.25rem 0.55rem;
      font-size: 0.75rem;
      border-radius: 6px;
    }

    .btn-danger {
      background: rgba(239, 68, 68, 0.15);
      border-color: rgba(239, 68, 68, 0.35);
      color: #fca5a5;
    }

    .btn-danger:hover {
      background: rgba(239, 68, 68, 0.3);
      color: #fff;
    }

    .btn-success {
      background: rgba(16, 185, 129, 0.15);
      border-color: rgba(16, 185, 129, 0.35);
      color: #6ee7b7;
    }

    .btn-success:hover {
      background: rgba(16, 185, 129, 0.3);
      color: #fff;
    }

    main {
      flex: 1;
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .stats-overview {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }

    .stat-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      backdrop-filter: blur(8px);
      transition: transform 0.2s, border-color 0.2s;
    }

    .stat-card:hover {
      border-color: #334155;
      transform: translateY(-2px);
    }

    .stat-card .label {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .stat-card .value {
      font-size: 1.65rem;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: baseline;
      gap: 0.4rem;
    }

    .stat-card .subtext {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .controls-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      background: var(--card-bg);
      padding: 0.85rem 1.25rem;
      border: 1px solid var(--card-border);
      border-radius: 12px;
    }

    .filter-tabs {
      display: flex;
      gap: 0.4rem;
      background: #090e17;
      padding: 0.25rem;
      border-radius: 8px;
      border: 1px solid #1a2333;
    }

    .filter-tab {
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 0.35rem 0.75rem;
      font-size: 0.8rem;
      font-weight: 500;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .filter-tab.active {
      background: #1e293b;
      color: #fff;
    }

    .search-box {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: #090e17;
      border: 1px solid #1a2333;
      padding: 0.4rem 0.85rem;
      border-radius: 8px;
      min-width: 280px;
    }

    .search-box input {
      background: transparent;
      border: none;
      color: #fff;
      font-size: 0.85rem;
      outline: none;
      width: 100%;
    }

    .search-box input::placeholder {
      color: #64748b;
    }

    .view-toggle {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    /* Container Grid */
    .container-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
      gap: 1.25rem;
    }

    .container-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      backdrop-filter: blur(8px);
      transition: all 0.25s ease;
      position: relative;
    }

    .container-card:hover {
      border-color: #3b82f6;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
      transform: translateY(-2px);
    }

    .container-card.running {
      border-left: 4px solid var(--success);
    }

    .container-card.exited, .container-card.stopped {
      border-left: 4px solid var(--danger);
      opacity: 0.85;
    }

    .container-card.paused {
      border-left: 4px solid var(--warning);
    }

    .card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .container-title {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      overflow: hidden;
    }

    .container-name {
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .container-image {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-family: var(--font-mono);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .state-pill {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      white-space: nowrap;
    }

    .state-running {
      background: rgba(16, 185, 129, 0.15);
      color: var(--success);
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .state-exited, .state-stopped {
      background: rgba(239, 68, 68, 0.15);
      color: var(--danger);
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .state-paused {
      background: rgba(245, 158, 11, 0.15);
      color: var(--warning);
      border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .metrics-section {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      background: rgba(8, 12, 20, 0.65);
      border: 1px solid #162032;
      border-radius: 8px;
      padding: 0.75rem;
    }

    .metric-row {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .metric-info {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.75rem;
    }

    .metric-info span.name {
      color: var(--text-muted);
    }

    .metric-info span.val {
      font-family: var(--font-mono);
      font-weight: 500;
      color: #e2e8f0;
    }

    .progress-track {
      height: 6px;
      background: #1e293b;
      border-radius: 9999px;
      overflow: hidden;
      position: relative;
    }

    .progress-fill {
      height: 100%;
      border-radius: 9999px;
      transition: width 0.4s ease, background-color 0.4s ease;
    }

    .progress-cpu {
      background: linear-gradient(90deg, #00f2fe, #4facfe);
    }

    .progress-mem {
      background: linear-gradient(90deg, #10b981, #059669);
    }

    .io-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      padding-top: 0.35rem;
      border-top: 1px dashed #1e293b;
      font-size: 0.7rem;
      color: var(--text-muted);
    }

    .io-item {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      font-family: var(--font-mono);
    }

    .ports-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      min-height: 24px;
    }

    .port-badge {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      background: #172236;
      border: 1px solid #25334c;
      color: #93c5fd;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.2s;
    }

    .port-badge:hover {
      background: #1e3a8a;
      color: #fff;
    }

    .card-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--card-border);
    }

    .action-group {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    /* Modal Styles */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(6px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 1.5rem;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-window {
      background: #0c111a;
      border: 1px solid #233148;
      border-radius: 14px;
      width: 100%;
      max-width: 900px;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
      overflow: hidden;
    }

    .modal-header {
      padding: 1rem 1.5rem;
      border-bottom: 1px solid #1e293b;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modal-title {
      font-size: 1.1rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .modal-body {
      padding: 1.25rem 1.5rem;
      overflow-y: auto;
      flex: 1;
    }

    .terminal-output {
      background: var(--terminal-bg);
      border: 1px solid #1b2536;
      border-radius: 8px;
      padding: 1rem;
      color: #d1d5db;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      line-height: 1.5;
      white-space: pre-wrap;
      overflow-x: auto;
      height: 480px;
      overflow-y: scroll;
    }

    footer {
      border-top: 1px solid var(--card-border);
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--text-muted);
      background: rgba(11, 15, 25, 0.5);
    }

    footer a {
      color: var(--accent);
      text-decoration: none;
    }

    footer a:hover {
      text-decoration: underline;
    }

    /* Empty state */
    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--text-muted);
    }

    .empty-state svg {
      width: 48px;
      height: 48px;
      margin-bottom: 1rem;
      stroke: #475569;
    }

    /* Table view */
    .table-responsive {
      overflow-x: auto;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      display: none;
    }

    .table-responsive.active {
      display: block;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
    }

    th {
      text-align: left;
      padding: 0.85rem 1rem;
      color: var(--text-muted);
      font-weight: 600;
      border-bottom: 1px solid var(--card-border);
      background: rgba(8, 12, 20, 0.6);
    }

    td {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid #162032;
      vertical-align: middle;
    }

    tr:hover td {
      background: rgba(30, 41, 59, 0.3);
    }
  </style>
</head>
<body>
  <header>
    <a href="/" class="brand">
      <div class="brand-logo">⚡</div>
      <div class="brand-text">
        <h1>Docklite</h1>
        <span>Ultra-lightweight Docker Daemon Monitor</span>
      </div>
    </a>

    <div class="nav-actions">
      <span class="badge-live" id="liveIndicator">
        <span class="pulse-dot"></span>
        <span id="liveText">Live (SSE)</span>
      </span>

      <button class="btn btn-sm" id="btnImages" title="Docker Images">
        📦 Images
      </button>

      <button class="btn btn-sm" id="btnApiDocs" title="REST API Reference">
        ⚡ API Docs
      </button>

      <button class="btn btn-sm btn-primary" id="btnRefresh" title="Aktualisieren">
        🔄 Refresh
      </button>
    </div>
  </header>

  <main>
    <!-- Top System Metrics Cards -->
    <section class="stats-overview">
      <div class="stat-card">
        <div class="label">Container Gesamt</div>
        <div class="value" id="statContainersTotal">0</div>
        <div class="subtext" id="statContainersBreakdown">0 running · 0 stopped</div>
      </div>

      <div class="stat-card">
        <div class="label">Docker Engine</div>
        <div class="value" id="statDockerVersion">-</div>
        <div class="subtext" id="statDockerOS">Direct docker.sock</div>
      </div>

      <div class="stat-card">
        <div class="label">Host CPUs & Memory</div>
        <div class="value" id="statCpuMem">-</div>
        <div class="subtext" id="statHostInfo">-</div>
      </div>

      <div class="stat-card">
        <div class="label">Images auf Host</div>
        <div class="value" id="statImagesTotal">0</div>
        <div class="subtext">Lokal gecacht</div>
      </div>
    </section>

    <!-- Controls Bar -->
    <section class="controls-bar">
      <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">Alle (<span id="countAll">0</span>)</button>
        <button class="filter-tab" data-filter="running">Running (<span id="countRunning">0</span>)</button>
        <button class="filter-tab" data-filter="stopped">Stopped (<span id="countStopped">0</span>)</button>
        <button class="filter-tab" data-filter="paused">Paused (<span id="countPaused">0</span>)</button>
      </div>

      <div class="search-box">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="searchInput" placeholder="Container oder Image filtern..." />
      </div>

      <div class="view-toggle">
        <button class="btn btn-sm active" id="btnViewGrid" title="Karten-Ansicht">🔲 Grid</button>
        <button class="btn btn-sm" id="btnViewTable" title="Tabellen-Ansicht">📋 Tabelle</button>
      </div>
    </section>

    <!-- Containers Grid Container -->
    <section class="container-grid" id="containersGrid">
      <div class="empty-state" style="grid-column: 1/-1;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
        <p>Lade Docker Container über Socket...</p>
      </div>
    </section>

    <!-- Containers Table Container -->
    <section class="table-responsive" id="containersTableWrapper">
      <table>
        <thead>
          <tr>
            <th>Status</th>
            <th>Name / ID</th>
            <th>Image</th>
            <th>CPU %</th>
            <th>Memory</th>
            <th>Ports</th>
            <th>Aktionen</th>
          </tr>
        </thead>
        <tbody id="containersTableBody">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </section>
  </main>

  <!-- Live Logs Modal -->
  <div class="modal-overlay" id="logsModal">
    <div class="modal-window">
      <div class="modal-header">
        <div class="modal-title">
          📜 Logs: <span id="logsContainerName" style="color:var(--accent);">-</span>
        </div>
        <div style="display:flex; gap:0.5rem; align-items:center;">
          <select id="logsTailSelect" class="btn btn-sm" style="background:#162032; border:1px solid #2a374f; color:#fff;">
            <option value="50">50 Zeilen</option>
            <option value="150" selected>150 Zeilen</option>
            <option value="300">300 Zeilen</option>
            <option value="1000">1000 Zeilen</option>
          </select>
          <button class="btn btn-sm" id="btnCopyLogs">📋 Kopieren</button>
          <button class="btn btn-sm btn-danger" id="btnCloseLogs">✕ Schließen</button>
        </div>
      </div>
      <div class="modal-body">
        <pre class="terminal-output" id="logsOutput">Lade Logs...</pre>
      </div>
    </div>
  </div>

  <!-- Inspect Modal -->
  <div class="modal-overlay" id="inspectModal">
    <div class="modal-window">
      <div class="modal-header">
        <div class="modal-title">
          🔍 Inspect: <span id="inspectContainerName" style="color:var(--accent);">-</span>
        </div>
        <button class="btn btn-sm btn-danger" id="btnCloseInspect">✕ Schließen</button>
      </div>
      <div class="modal-body">
        <pre class="terminal-output" id="inspectOutput">Lade JSON...</pre>
      </div>
    </div>
  </div>

  <!-- Docker Images Modal -->
  <div class="modal-overlay" id="imagesModal">
    <div class="modal-window">
      <div class="modal-header">
        <div class="modal-title">
          📦 Lokale Docker Images
        </div>
        <button class="btn btn-sm btn-danger" id="btnCloseImages">✕ Schließen</button>
      </div>
      <div class="modal-body">
        <div class="table-responsive active">
          <table>
            <thead>
              <tr>
                <th>Repository / Tag</th>
                <th>Image ID</th>
                <th>Größe</th>
                <th>Erstellt</th>
              </tr>
            </thead>
            <tbody id="imagesTableBody">
              <!-- Filled via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- API Docs Modal -->
  <div class="modal-overlay" id="apiDocsModal">
    <div class="modal-window">
      <div class="modal-header">
        <div class="modal-title">
          ⚡ Docklite REST API Referenz
        </div>
        <button class="btn btn-sm btn-danger" id="btnCloseApiDocs">✕ Schließen</button>
      </div>
      <div class="modal-body">
        <p style="margin-bottom:1rem; color:var(--text-muted); font-size:0.85rem;">
          Docklite bietet eine direkte, blitzschnelle HTTP REST API für Automatisierung, Dashboards und Scripts.
        </p>
        <div style="display:flex; flex-direction:column; gap:0.75rem; font-family:var(--font-mono); font-size:0.8rem;">
          <div style="background:#05070a; padding:0.75rem; border-radius:6px; border:1px solid #1e293b;">
            <strong style="color:var(--info);">GET /api/v1/ping</strong>
            <div style="color:var(--text-muted); margin-top:0.25rem;">Health-Check & Docker-Socket Erreichbarkeit</div>
          </div>
          <div style="background:#05070a; padding:0.75rem; border-radius:6px; border:1px solid #1e293b;">
            <strong style="color:var(--info);">GET /api/v1/system</strong>
            <div style="color:var(--text-muted); margin-top:0.25rem;">Host System-Informationen, CPU-Kerne, Memory</div>
          </div>
          <div style="background:#05070a; padding:0.75rem; border-radius:6px; border:1px solid #1e293b;">
            <strong style="color:var(--info);">GET /api/v1/containers?all=true&stats=true</strong>
            <div style="color:var(--text-muted); margin-top:0.25rem;">Container-Liste inklusive Live CPU% und Memory</div>
          </div>
          <div style="background:#05070a; padding:0.75rem; border-radius:6px; border:1px solid #1e293b;">
            <strong style="color:var(--info);">GET /api/v1/containers/&#123;id&#125;/stats</strong>
            <div style="color:var(--text-muted); margin-top:0.25rem;">Echtzeit-Ressourcenverbrauch (CPU%, Mem, I/O)</div>
          </div>
          <div style="background:#05070a; padding:0.75rem; border-radius:6px; border:1px solid #1e293b;">
            <strong style="color:var(--info);">GET /api/v1/containers/&#123;id&#125;/logs?tail=150</strong>
            <div style="color:var(--text-muted); margin-top:0.25rem;">Demuxte Stdout & Stderr Logs</div>
          </div>
          <div style="background:#05070a; padding:0.75rem; border-radius:6px; border:1px solid #1e293b;">
            <strong style="color:var(--success);">POST /api/v1/containers/&#123;id&#125;/start|stop|restart|pause|unpause</strong>
            <div style="color:var(--text-muted); margin-top:0.25rem;">Container-Lifecycle Steuerung</div>
          </div>
          <div style="background:#05070a; padding:0.75rem; border-radius:6px; border:1px solid #1e293b;">
            <strong style="color:var(--accent);">GET /api/v1/live</strong>
            <div style="color:var(--text-muted); margin-top:0.25rem;">Server-Sent Events (SSE) Live Stream aller Container & Stats alle 2s</div>
          </div>
        </div>
      </div>
    </div>
  </div>

